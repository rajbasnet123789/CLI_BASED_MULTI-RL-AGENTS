# ---------------------------------------------------------------------------
# Orion AI configuration — Vertex AI via gcloud ADC (no API key required)
# Copy this file to `.env`:  cp .env.example .env
# Every setting can also be supplied as an ORION_* environment variable.
# ---------------------------------------------------------------------------

# Provider ------------------------------------------------------------------
# gcloud = Vertex AI using your local `gcloud auth application-default login`
# credentials. No API key is needed by the user. This is the default.
ORION_LLM_PROVIDER=gcloud
ORION_GCLOUD_PROJECT=your-gcp-project-id
ORION_GCLOUD_REGION=global
ORION_GCLOUD_ENDPOINT=aiplatform.googleapis.com

# Multi-agent role allocation ----------------------------------------------
# Principal architect / repository analysis and initial plan.
ORION_ARCHITECT_MODEL=claude-opus-5-5
# Task decomposition and initial code generation.
ORION_GENERATOR_MODEL=glm-5-maas
# Code evaluator (uses real test/lint/typecheck signals).
ORION_EVALUATOR_MODEL=claude-opus-5-5
# Code reviewer.
ORION_REVIEWER_MODEL=gemini-3-flash-preview
# Debugging agent.
ORION_DEBUGGING_MODEL=glm-5-maas
# Context summarization.
ORION_SUMMARIZER_MODEL=gemini-flash-lite

# General model (fallback for roles without an explicit override) -----------
ORION_MODEL=gemini-3.5-flash

# Legacy compatibility only (not needed for the gcloud default) ------------
# ORION_PLANNER_MODEL=gemini-3.1-pro-preview
# ORION_CODER_MODEL=gemini-3.5-flash
# ORION_REVIEWER_MODEL=gemini-3.5-flash
# GEMINI_API_KEY=                # only for ORION_LLM_PROVIDER=gemini
# ORION_VERTEX=auto

# Behaviour ----------------------------------------------------------------
ORION_MODE=build
# ask = confirm shell commands, auto = never ask, deny = never run shell tools
ORION_APPROVAL=ask
ORION_TEMPERATURE=0.2
ORION_MAX_OUTPUT_TOKENS=8192
ORION_MAX_ITERATIONS=3
ORION_MAX_TOOL_ROUNDS=12
ORION_AUTO_INDEX=true
ORION_DRY_RUN=false

# Retrieval ----------------------------------------------------------------
# local = offline hashing embedder (no API key, compatible with existing index)
# gemini = Vertex embedding model (requires ADC); auto chooses based on provider.
ORION_EMBEDDINGS=local
ORION_EMBEDDING_MODEL=text-embedding-005
ORION_TOP_K=8
ORION_CHUNK_CHARS=1200
ORION_CHUNK_OVERLAP=150
ORION_MAX_FILE_BYTES=512000

# Storage ------------------------------------------------------------------
# Defaults to <project>/.orion. Point this somewhere writable inside Docker.
# ORION_DATA_DIR=.orion
# ORION_SESSION_PERSIST=true

# UI -----------------------------------------------------------------------
ORION_THEME=orion
ORION_LOG_LEVEL=WARNING

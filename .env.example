# ---------------------------------------------------------------------------
# Orion AI configuration
# Copy this file to `.env` and fill in your key:  cp .env.example .env
# Every setting can also be supplied as an ORION_* environment variable.
# ---------------------------------------------------------------------------

# Provider ------------------------------------------------------------------
# gemini (default) needs a key. local uses Ollama and needs no API key.
ORION_LLM_PROVIDER=gemini
# ORION_LOCAL_BASE_URL=http://localhost:11434/v1
# ORION_LOCAL_MODEL=qwen2.5:7b-instruct
# ORION_LOCAL_API_KEY=
# ORION_LOCAL_TIMEOUT=120

# Gemini credentials --------------------------------------------------------
# Required for ORION_LLM_PROVIDER=gemini. Google AI Studio key (starts with
# "AIza") or Vertex AI express key (starts with "AQ."). Create one at
# https://aistudio.google.com/apikey. Leave blank when using a local model.
GEMINI_API_KEY=

# auto = detect from the key prefix (AQ. => Vertex AI express mode). If that
# backend is rejected, Orion retries once with the other one automatically.
# true / false force Vertex AI / Google AI Studio respectively. Some "AQ." keys
# only work with AI Studio: set ORION_VERTEX=false if doctor reports a Vertex
# PERMISSION_DENIED / SERVICE_DISABLED error.
ORION_VERTEX=auto

# Models -------------------------------------------------------------------
# Flash is fast and cheap; use gemini-3.1-pro-preview for harder reasoning.
ORION_MODEL=gemini-3.5-flash
# ORION_PLANNER_MODEL=gemini-3.1-pro-preview
# ORION_CODER_MODEL=gemini-3.5-flash
# ORION_REVIEWER_MODEL=gemini-3.5-flash
ORION_EMBEDDING_MODEL=gemini-embedding-001

# Behaviour ----------------------------------------------------------------
ORION_MODE=build
# ask = confirm shell commands, auto = never ask, deny = never run shell tools
ORION_APPROVAL=ask
ORION_TEMPERATURE=0.2
ORION_MAX_OUTPUT_TOKENS=8192
ORION_MAX_ITERATIONS=3
ORION_MAX_TOOL_ROUNDS=12
ORION_AUTO_INDEX=true
ORION_DRY_RUN=false

# Retrieval ----------------------------------------------------------------
# gemini = Gemini embeddings, local = offline hashing embedder, auto = gemini if
# key and Gemini provider, otherwise local. Local models always use offline.
ORION_EMBEDDINGS=auto
ORION_TOP_K=8
ORION_CHUNK_CHARS=1200
ORION_CHUNK_OVERLAP=150
ORION_MAX_FILE_BYTES=512000

# Storage ------------------------------------------------------------------
# Defaults to <project>/.orion. Point this somewhere writable inside Docker.
# ORION_DATA_DIR=.orion
# ORION_SESSION_PERSIST=true

# UI -----------------------------------------------------------------------
ORION_THEME=orion
ORION_LOG_LEVEL=WARNING
